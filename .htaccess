  RewriteRule ^construction-material-supply-projects-telangana/?$ index.html [L]
  RewriteRule ^on-site-concrete-manufacturing-process/?$ index.html [L]
  RewriteRule ^small-quantity-concrete-products-supply/?$ index.html [L]
